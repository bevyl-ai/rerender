{
  "name": "@bevyl-ai/rerender",
  "version": "0.4.1",
  "description": "Random-access frame extraction from mp4 URLs \u2014 any frame in one Range request and one decode, with no dependencies. Plus a drop-in MIT Remotion alternative that renders real DOM to MP4 with WebCodecs and mediabunny. No ffmpeg.",
  "license": "MIT",
  "author": "Noah Lindner",
  "homepage": "https://rerender.video",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bevyl-ai/rerender.git"
  },
  "bugs": {
    "url": "https://github.com/bevyl-ai/rerender/issues"
  },
  "keywords": [
    "webcodecs",
    "mp4",
    "frame-extraction",
    "thumbnails",
    "filmstrip",
    "video",
    "seek",
    "remotion",
    "react",
    "animation",
    "renderer"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/extract.js",
  "types": "./dist/extract.d.ts",
  "exports": {
    ".": {
      "types": "./dist/extract.d.ts",
      "default": "./dist/extract.js"
    },
    "./extract": {
      "types": "./dist/extract.d.ts",
      "default": "./dist/extract.js"
    },
    "./media-parser": {
      "types": "./dist/media-parser.d.ts",
      "default": "./dist/media-parser.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "rerender": "tsx src/cli.ts",
    "studio": "tsx src/cli.ts studio",
    "dev": "vite",
    "build": "vite build",
    "deploy": "npm run build && npx wrangler deploy",
    "test": "npm run test:extract && vite build && tsx test/export.test.ts",
    "test:export": "tsx test/export.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "check": "biome check .",
    "knip": "knip",
    "publint": "publint",
    "test:extract": "tsx test/extract-sample-table.test.ts && tsx test/extract-codecs.test.ts && tsx test/extract-fmp4.test.ts && tsx test/extract-hardening.test.ts && tsx test/extract-source.test.ts && tsx test/extract-gop-window.test.ts && tsx test/extract-abort.test.ts && tsx test/frame-store.test.ts",
    "build:lib": "tsup && node scripts/check-dist.mjs",
    "prepack": "npm run build:lib",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@aws-sdk/client-lambda": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@biomejs/biome": "^2.5.1",
    "@mediabunny/aac-encoder": "^1.49.0",
    "@puppeteer/browsers": "^3.0.5",
    "@remotion/webcodecs": "^4.0.501",
    "@remotion/zod-types": "^4.0.484",
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.1",
    "knip": "^6.23.0",
    "mediabunny": "^1.49.0",
    "publint": "^0.3.21",
    "puppeteer-core": "^25.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.484",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "wrangler": "^4.116.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.3"
  },
  "peerDependencies": {
    "mediabunny": "^1.49.0"
  },
  "peerDependenciesMeta": {
    "mediabunny": {
      "optional": true
    }
  },
  "knip": {
    "entry": [
      "demo/codecs-main.tsx",
      "cloud/handler.mjs",
      "cloud/lambda-client.ts",
      "render/studio-render-core.tsx",
      "render/studio-main.tsx",
      "render/encode-worker.ts",
      "render/mux-worker.ts",
      "studio/main.tsx",
      "src/transitions/index.ts",
      "src/media-utils/index.ts",
      "templates/*/src/index.ts",
      "src/media/index.ts",
      "src/index.ts",
      "src/core/audio-engine.ts"
    ],
    "project": [
      "**/*.{ts,tsx,mjs}"
    ],
    "rules": {
      "duplicates": "off"
    }
  },
  "tsup": {
    "entry": {
      "extract": "src/extract/index.ts",
      "media-parser": "src/media-parser/index.ts"
    },
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "target": "es2022",
    "external": [
      "mediabunny"
    ]
  }
}
