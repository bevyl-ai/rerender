{
  "name": "@bevyl-ai/rerender",
  "version": "0.4.1",
  "description": "Random-access frame extraction from mp4 URLs — any frame in one Range request and one decode, with no dependencies. Plus a drop-in MIT Remotion alternative that renders real DOM to MP4 with WebCodecs and mediabunny. No ffmpeg.",
  "license": "MIT",
  "author": "Noah Lindner",
  "homepage": "https://rerender.video",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bevyl-ai/rerender.git"
  },
  "bugs": {
    "url": "https://github.com/bevyl-ai/rerender/issues"
  },
  "keywords": [
    "webcodecs",
    "mp4",
    "frame-extraction",
    "thumbnails",
    "filmstrip",
    "video",
    "seek",
    "remotion",
    "react",
    "animation",
    "renderer"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/extract.js",
  "types": "./dist/extract.d.ts",
  "exports": {
    ".": {
      "types": "./dist/extract.d.ts",
      "default": "./dist/extract.js"
    },
    "./extract": {
      "types": "./dist/extract.d.ts",
      "default": "./dist/extract.js"
    },
    "./media-parser": {
      "types": "./dist/media-parser.d.ts",
      "default": "./dist/media-parser.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "rerender": "tsx src/cli.ts",
    "studio": "tsx src/cli.ts studio",
    "dev": "vite",
    "build": "vite build",
    "deploy": "bun run build && bunx wrangler deploy",
    "test": "bun run test:extract && vite build && bun test/export.test.ts",
    "test:export": "bun test/export.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "check": "biome check .",
    "knip": "knip",
    "publint": "publint",
    "test:extract": "bun test/extract-sample-table.test.ts && bun test/extract-abort.test.ts && bun test test/extract-codecs.test.ts test/extract-fmp4.test.ts test/extract-hardening.test.ts test/extract-source.test.ts test/extract-gop-window.test.ts test/frame-store.test.ts",
    "build:lib": "tsdown && bun scripts/check-dist.mjs",
    "prepack": "bun run build:lib",
    "attw": "attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@aws-sdk/client-lambda": "^3.1110.0",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@biomejs/biome": "^2.5.8",
    "@mediabunny/aac-encoder": "^1.53.1",
    "@puppeteer/browsers": "^3.2.0",
    "@remotion/webcodecs": "^4.0.509",
    "@remotion/zod-types": "^4.0.509",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "knip": "^6.32.2",
    "mediabunny": "^1.53.1",
    "publint": "^0.3.23",
    "puppeteer-core": "^25.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.509",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0",
    "zod": "^4.4.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.19",
    "bun": ">=1.3.14"
  },
  "peerDependencies": {
    "mediabunny": "^1.49.0"
  },
  "peerDependenciesMeta": {
    "mediabunny": {
      "optional": true
    }
  },
  "knip": {
    "entry": [
      "demo/codecs-main.tsx",
      "cloud/handler.mjs",
      "cloud/lambda-client.ts",
      "render/studio-render-core.tsx",
      "render/studio-main.tsx",
      "render/encode-worker.ts",
      "render/mux-worker.ts",
      "studio/main.tsx",
      "src/transitions/index.ts",
      "src/media-utils/index.ts",
      "templates/*/src/index.ts",
      "src/media/index.ts",
      "src/index.ts",
      "src/core/audio-engine.ts"
    ],
    "project": [
      "**/*.{ts,tsx,mjs}"
    ],
    "rules": {
      "duplicates": "off"
    }
  }
}
